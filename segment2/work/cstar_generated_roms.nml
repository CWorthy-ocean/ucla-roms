    output_period_bgc_avg_dia = 60.0
    output_period_bgc_his = 86400.0
    output_period_bgc_his_dia = 86400.0
    wrt_bgc_avg = .false.
    wrt_bgc_dia_avg = .false.
    wrt_bgc_dia_his = .true.
    wrt_bgc_his = .true.

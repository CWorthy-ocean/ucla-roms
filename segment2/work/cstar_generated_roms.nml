/

&bottom_drag_settings
    rdrg = 0.0
    rdrg2 = 0.001
    zob = 0.01
/

&calc_pflx_settings
    calc_pflx = .true.
    pflx_timescale = 86400.0
/

&cdr_frc_settings
    cdr_file = 'cdr.nc'
    cdr_forcing_3d = .false.
    cdr_forcing_depth_profiles = .false.
    cdr_forcing_parameterized = .true.
    cdr_ncdr_parm = 1
    cdr_nz_chd = 50
    cdr_relocate_to_wet_pts = .true.
    cdr_source = .false.
    cdr_time_interpolation = .false.
    cdr_volume = .false.
/

&cdr_output_settings
    cdr_monthly_averages = .false.
    do_cdr_output = .false.
    nrpf_cdr = 24
    output_period_cdr = 3600.0
    wrt_cdr_avg = .true.
/

&diagnostics_settings
    diag_avg = .false.
    diag_trc = .false.
    diag_uv = .false.
    nrpf_diag = 7
    output_period_diag = 86400.0
/

&dic_alk_correction
    dcdt = 7.777
/

&extract_data_settings
    do_extract = .true.
    extract_file = '/anvil/scratch/x-uheede/cstar/iceland1/tasks/segment2/input/input_datasets/Iceland1_256procs_nesting.nc'

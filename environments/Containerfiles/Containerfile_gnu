FROM docker.io/mambaorg/micromamba:1.5.5

ENV ENV_NAME=roms-ci
USER root
RUN apt update && apt install -y \
    rsync make wget git cpp cmake pkg-config\
    && rm -rf /var/lib/apt/lists/*

# Create the environment: toolchain + the python deps shared with the ifx
# image. Two steps because micromamba 1.5.5 accepts only one yaml per command;
# the install step re-solves against the pinned toolchain, so toolchain pins
# win over anything the python deps would drag in.
COPY conda_gnu_toolchain.yml conda_python_deps.yml /tmp/

RUN micromamba create -n $ENV_NAME -f /tmp/conda_gnu_toolchain.yml \
    && micromamba install -y -n $ENV_NAME -f /tmp/conda_python_deps.yml
ENV MAMBA_DOCKERFILE_ACTIVATE=1

# Set the default shell to run inside the environment
SHELL ["micromamba", "run", "-n", "roms-ci", "/bin/bash", "-c"]

CMD ["bash"]
ENV MPIHOME=/opt/conda/envs/roms-ci \
    NETCDFHOME=/opt/conda/envs/roms-ci \
    LD_LIBRARY_PATH=/opt/conda/envs/roms-ci/lib

# Install Score-P
WORKDIR /opt/
RUN bash -c "echo 'int main(){return 0;}' > /tmp/t.c && \
    /opt/conda/envs/roms-ci/bin/mpicc -show && \
    /opt/conda/envs/roms-ci/bin/mpicc /tmp/t.c -o /tmp/t 2>&1; \
    ls -la /opt/conda/envs/roms-ci/lib/libmpi* 2>&1"
ENV PATH=/opt/conda/envs/roms-ci/bin:$PATH
ENV SCOREP_ROOT=/opt/scorep_9.4_install
RUN cd /opt \
    && wget -q https://zenodo.org/records/17964650/files/scorep-9.4.tar.gz \
    && tar -xvf scorep-9.4.tar.gz \
    && rm scorep-9.4.tar.gz \
    && mkdir $SCOREP_ROOT \
    && cd scorep-9.4 \
    && mkdir _build \
    && cd _build \
    && ../configure --prefix=$SCOREP_ROOT --with-mpi=mpich --with-libbfd=download --with-libgotcha=download \
        CC=/opt/conda/envs/roms-ci/bin/x86_64-conda-linux-gnu-cc \
        CXX=/opt/conda/envs/roms-ci/bin/x86_64-conda-linux-gnu-c++ \
        FC=/opt/conda/envs/roms-ci/bin/x86_64-conda-linux-gnu-gfortran \
        F77=/opt/conda/envs/roms-ci/bin/x86_64-conda-linux-gnu-gfortran \
        MPICC=/opt/conda/envs/roms-ci/bin/mpicc \
        MPICXX=/opt/conda/envs/roms-ci/bin/mpicxx \
        MPIFC=/opt/conda/envs/roms-ci/bin/mpifort \
        MPIF77=/opt/conda/envs/roms-ci/bin/mpif77
WORKDIR /opt/scorep-9.4/_build
RUN bash -c "make -j$(nproc) && make install"
WORKDIR /opt/
RUN rm -rf /opt/scorep-9.4
ENV PATH=$SCOREP_ROOT/bin:$PATH
ENV LD_LIBRARY_PATH=$SCOREP_ROOT/lib:$SCOREP_ROOT/lib/scorep/libbfd/2.45/lib:$SCOREP_ROOT/lib/scorep/libgotcha/1.0.8/lib:${LD_LIBRARY_PATH}
ENV LIBRARY_PATH=$SCOREP_ROOT/lib:$SCOREP_ROOT/lib/scorep/libbfd/2.45/lib:$SCOREP_ROOT/lib/scorep/libgotcha/1.0.8/lib
ENV LDFLAGS="-Wl,-rpath,$SCOREP_ROOT/lib -Wl,-rpath,$SCOREP_ROOT/lib/scorep/libbfd/2.45/lib -Wl,-rpath,$SCOREP_ROOT/lib/scorep/libgotcha/1.0.8/lib -Wl,-rpath-link,$SCOREP_ROOT/lib -Wl,-rpath-link,$SCOREP_ROOT/lib/scorep/libbfd/2.45/lib -Wl,-rpath-link,$SCOREP_ROOT/lib/scorep/libgotcha/1.0.8/lib"

# Install MARBL
ENV MARBL_ROOT=/opt/MARBL
WORKDIR /opt
RUN bash -c "wget https://github.com/marbl-ecosys/MARBL/archive/refs/tags/marbl0.45.0.tar.gz \
        && tar xvf marbl0.45.0.tar.gz \
	&& rm marbl0.45.0.tar.gz \
	&& mv MARBL-marbl0.45.0 $MARBL_ROOT  \
	&& cd $MARBL_ROOT/src \
	&& make gnu USEMPI=TRUE"

# Install ParallelIO (PIO), needed when ROMS is compiled with PARALLEL_IO.
# The CWorthy-ocean fork is required: src/pio_roms.F90 passes force_nofill= to
# PIO_initdecomp, which stock NCAR ParallelIO (through pio2_7_0) does not
# accept. Built in-tree in a directory literally named `build` with no install
# step because ROMS' Makedefs.inc links $(PIO_ROOT)/build/src/{clib,flib}
# directly. The cmake invocation mirrors C-Star's PIOExternalCodeBase.
ENV PIO_ROOT=/opt/ParallelIO \
    PNETCDFHOME=/opt/conda/envs/roms-ci
RUN bash -c "git clone --depth 1 --branch 2.7.1-fork https://github.com/CWorthy-ocean/ParallelIO.git \$PIO_ROOT \
    && cd \$PIO_ROOT \
    && PKG_CONFIG_PATH=/opt/conda/envs/roms-ci/lib/pkgconfig:\${PKG_CONFIG_PATH:-} \
       cmake -S . -B build \
        -DCMAKE_C_COMPILER=/opt/conda/envs/roms-ci/bin/mpicc \
        -DCMAKE_Fortran_COMPILER=/opt/conda/envs/roms-ci/bin/mpif90 \
        -DCMAKE_PREFIX_PATH=/opt/conda/envs/roms-ci \
        -DHAVE_PAR_FILTERS=FALSE \
        -DPIO_ENABLE_TIMING=OFF \
        -DPIO_ENABLE_TESTS=OFF \
        -DPIO_ENABLE_EXAMPLES=OFF \
        -DPIO_ENABLE_DOC=OFF \
        -DBUILD_SHARED_LIBS=OFF \
    && cmake --build build --parallel 4"

# Container metadata:
LABEL org.opencontainers.image.description="gfortran-based, conda-managed ROMS build env with MARBL 0.45.0, ParallelIO 2.7.1-fork, and Score-P 9.4.0"
COPY Containerfile_gnu /image-metadata/Containerfile